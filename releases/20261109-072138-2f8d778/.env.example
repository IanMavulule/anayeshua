# Copie para .env e preencha. O ficheiro .env nunca é versionado.

# Segredo que assina sessões e tokens de média (obrigatório em produção).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANA_SECRET=

# PostgreSQL (obrigatório). Crie a base antes, ex.: CREATE DATABASE anayeshua;
# O esquema é criado por migrações SQL (server/models/store/migrations). Numa base
# vazia são aplicadas no arranque; numa base com dados o servidor recusa arrancar
# até fazer uma cópia (pg_dump) e correr: npm run db:migrate
DATABASE_URL=postgres://utilizador:senha@localhost:5432/anayeshua
# Esquema das tabelas (por omissão, public).
# DATABASE_SCHEMA=public
# auto = aplicar migrações pendentes no arranque mesmo com dados (sem cópia prévia).
# DATABASE_MIGRATE=auto
# --- Supabase -------------------------------------------------------------
# Em Project Settings → Database → Connection string, copie o "Session pooler"
# (porta 5432; IPv4) ou a ligação directa (db.<ref>.supabase.co, só IPv6).
# O "Transaction pooler" (porta 6543) não é suportado.
#   DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<região>.pooler.supabase.com:5432/postgres
# Use um esquema próprio: o public é exposto pela Data API do Supabase e o
# servidor recusa arrancar com ele.
#   DATABASE_SCHEMA=ana
# TLS: activo automaticamente no Supabase. Para validar o certificado, descarregue
# a CA (Database → SSL Configuration) e indique o caminho:
#   DATABASE_SSL_CA=./secrets/supabase-ca.crt
# DATABASE_SSL=require | verify-full | disable força o modo noutros servidores.
# Para cópias (pg_dump) instale ferramentas PostgreSQL da mesma versão do Supabase.
# Base para os testes (por omissão, DATABASE_URL). Cada execução usa um esquema
# temporário test_… que é apagado no fim.
# TEST_DATABASE_URL=postgres://utilizador:senha@localhost:5432/anayeshua

# Porta da API (o Vite encaminha /api, /media e /uploads para aqui).
PORT=8787

# Conta de administração criada no primeiro arranque, se ainda não existir.
# Sem ANA_ADMIN_PASSWORD é gerada uma palavra-passe e mostrada uma vez na consola.
ANA_ADMIN_EMAIL=ana@example.com
ANA_ADMIN_PASSWORD=
ANA_ADMIN_NAME=Ana Yeshua

# Pastas das capas carregadas e dos vídeos (relativas à raiz do projecto).
# ANA_DATA_DIR=data
# ANA_VIDEOS_DIR=videos

# Conversão dos vídeos para várias qualidades (HLS). Precisa do ffmpeg e do ffprobe
# (Windows: winget install Gyan.FFmpeg). Sem eles os vídeos tocam só no formato original.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# --- Pagamentos (iMaliWay / Paytek Africa) -------------------------------
# Sem estas credenciais o checkout fica indisponível (não há modo simulado).
# Base URL fornecida pela Paytek (sandbox e produção podem diferir).
IMALIWAY_BASE_URL=https://paytek-africa.net:11901/api/partners/imaliway/v2
IMALIWAY_CLIENT_ID=
IMALIWAY_API_KEY=
# Chave pública da Paytek em PEM (use \n para quebras de linha) ou caminho para o ficheiro.
IMALIWAY_PUBLIC_KEY=
# IMALIWAY_PUBLIC_KEY_FILE=./secrets/imaliway-public.pem
# Conta STORE de 9 dígitos que recebe os pagamentos.
IMALIWAY_STORE_ACCOUNT=
# Segredo dos webhooks; o callback_url a registar é https://<domínio>/api/payments/imaliway/webhook
IMALIWAY_WEBHOOK_SECRET=

# --- Deploy (npm run deploy) ---------------------------------------------
# Servidor de produção (SSH) e pasta da app. Ver scripts/deploy.ts.
# DEPLOY_HOST=ian@168.231.127.248
# DEPLOY_PATH=/var/www/anayeshua
