{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023", "lib": ["ES2023"], "module": "ESNext",
    "skipLibCheck": true, "moduleResolution": "bundler", "allowImportingTsExtensions": true,
    "esModuleInterop": true, "moduleDetection": "force", "noEmit": true,
    "strict": true, "erasableSyntaxOnly": true, "types": ["node"]
  },
  "include": ["vite.config.ts", "server"]
}
